<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Flyxteele SaaS Bot</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="bg-slate-900 text-white font-sans">
  <nav class="p-6 border-b border-slate-800">
    <div class="max-w-5xl mx-auto flex justify-between items-center">
      <h1 class="text-2xl font-bold text-emerald-400">Flyxteele 🦖</h1>
      <a href="https://t.me/BotUsername" class="bg-emerald-500 px-5 py-2 rounded-lg font-medium hover:bg-emerald-600 transition">Mulai Sekarang</a>
    </div>
  </nav>

  <main class="max-w-5xl mx-auto py-20 px-6 text-center">
    <h2 class="text-5xl md:text-7xl font-extrabold mb-6">
      Buka Toko di Telegram <br> <span class="text-emerald-400">Semudah Chatting.</span>
    </h2>
    <p class="text-slate-400 text-xl mb-10 max-w-2xl mx-auto">
      Platform SaaS Bot otomatis dengan integrasi Deno KV. Kelola produk, stok, dan pelanggan langsung dari satu bot.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700 w-64">
        <h3 class="text-emerald-400 font-bold text-xl">Gratis</h3>
        <p class="text-sm text-slate-500">Untuk 5 produk pertama</p>
      </div>
      <div class="bg-slate-800 p-6 rounded-2xl border border-emerald-500/50 w-64">
        <h3 class="text-emerald-400 font-bold text-xl">Otomatis</h3>
        <p class="text-sm text-slate-500">Integrasi Deno KV Cloud</p>
      </div>
    </div>
  </main>
</body>
</html>
